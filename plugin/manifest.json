{
  "id": "org.pproagentbridge.panel",
  "name": "Agent Bridge",
  "version": "0.6.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "26.3.0"
    }
  ],
  "manifestVersion": 5,
  "requiredPermissions": {
    "network": {
      "domains": ["ws://localhost/"]
    },
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [],
      "extensions": [".bat", ".pyw"]
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "claudeBridgePanel",
      "minimumSize": {
        "width": 260,
        "height": 200
      },
      "maximumSize": {
        "width": 2000,
        "height": 2000
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 360
      },
      "preferredFloatingSize": {
        "width": 340,
        "height": 420
      },
      "label": {
        "default": "Agent Bridge"
      }
    }
  ]
}
